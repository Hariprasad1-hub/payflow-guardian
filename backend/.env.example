# backend/.env.example
# Environment variables for PayFlow Guardian backend (development)
# Copy this file to .env and adjust values as needed.

# SQLite file location (relative to backend folder)
DATABASE_URL=sqlite:///./payflow.db

# Allowed origins for CORS (React dev server)
ALLOWED_ORIGINS=http://localhost:5173

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

